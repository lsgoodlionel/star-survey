{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded agent context capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capsuleDigest", "stablePrefix", "taskDelta", "diagnostic", "totalBytes", "sources"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "capsuleDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stablePrefix": {"type": "string", "maxLength": 12288},
    "taskDelta": {"type": "string", "maxLength": 8192},
    "diagnostic": {"anyOf": [{"type": "string", "maxLength": 4096}, {"type": "null"}]},
    "totalBytes": {"type": "integer", "minimum": 0, "maximum": 24576},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceType", "path", "startLine", "endLine", "digest", "byteCount", "reason"],
        "properties": {
          "sourceType": {"enum": ["repository", "harness", "memory_projection"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
          "startLine": {"type": "integer", "minimum": 1},
          "endLine": {"type": "integer", "minimum": 1},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byteCount": {"type": "integer", "minimum": 0, "maximum": 24576},
          "reason": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    }
  }
}
