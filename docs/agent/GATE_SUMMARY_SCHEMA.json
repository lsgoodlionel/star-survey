{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateId", "status", "exitCode", "durationMs", "counts", "evidenceKey", "headCommit", "source", "reused", "diagnostic"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "gateId": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "status": {"enum": ["pending", "running", "passed", "failed", "timed_out"]},
    "exitCode": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
    "durationMs": {"type": "integer", "minimum": 0},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "skipped", "errors"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "evidenceKey": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "headCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {"enum": ["local", "github", "reused"]},
    "reused": {"type": "boolean"},
    "diagnostic": {"anyOf": [{"type": "string", "maxLength": 4096}, {"type": "null"}]}
  }
}
