{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Privacy-safe token usage report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "since", "until", "planPath", "sessions", "usage", "metrics"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "since": {"type": "string", "format": "date-time", "maxLength": 64},
    "until": {"type": "string", "format": "date-time", "maxLength": 64},
    "planPath": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "subagents", "reviewers"],
      "properties": {
        "main": {"type": "integer", "minimum": 0},
        "subagents": {"type": "integer", "minimum": 0},
        "reviewers": {"type": "integer", "minimum": 0}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawTokens", "cachedInputTokens", "activeTokens", "outputTokens", "reasoningTokens"],
      "properties": {
        "rawTokens": {"type": "integer", "minimum": 0},
        "cachedInputTokens": {"type": "integer", "minimum": 0},
        "activeTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0},
        "reasoningTokens": {"type": "integer", "minimum": 0}
      }
    },
    "reviewUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawTokens", "cachedInputTokens", "activeTokens", "outputTokens", "reasoningTokens"],
      "properties": {
        "rawTokens": {"type": "integer", "minimum": 0},
        "cachedInputTokens": {"type": "integer", "minimum": 0},
        "activeTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0},
        "reasoningTokens": {"type": "integer", "minimum": 0}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateExecutionCount", "gateReuseCount", "duplicateGateAvoidedCount", "failureFingerprintCount", "diagnosticBytesExposed"],
      "properties": {
        "gateExecutionCount": {"type": "integer", "minimum": 0},
        "gateReuseCount": {"type": "integer", "minimum": 0},
        "duplicateGateAvoidedCount": {"type": "integer", "minimum": 0},
        "failureFingerprintCount": {"type": "integer", "minimum": 0},
        "diagnosticBytesExposed": {"type": "integer", "minimum": 0}
      }
    }
  }
}
