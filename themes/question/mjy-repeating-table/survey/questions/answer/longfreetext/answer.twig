{#
/**
 * MJY 自增表格：作答者自行增删行，整张表序列化成 JSON 存进长文本列。
 *
 * 真正被提交的永远是下面那个 textarea（name = 引擎字段名），表格只是它的编辑器。
 * 关掉 JavaScript 时 textarea 直接可见，作答者仍能提交合法的 JSON —— 服务端
 * 校验（MjyQuestionExtensions::beforeSurveyPage）对两条路径一视同仁。
 *
 * @var name  引擎字段名（Q<qid>）
 * @var dispVal  已存的 JSON
 * @var question_template_attribute  题型主题属性（mjy_table_columns / min / max）
 */
#}
<!-- MJY repeating table -->
<div class="{{ coreClass }} {{ extraclass }} mjy-repeating-table"
     data-mjy-repeating-table="1"
     data-mjy-field="{{ name }}"
     {# 只能用沙箱白名单里的过滤器，别名 e 不在其中（application/config/internal.php:331） #}
     data-mjy-columns="{{ question_template_attribute.mjy_table_columns|escape('html_attr') }}"
     data-mjy-min-rows="{{ question_template_attribute.mjy_table_min_rows|default(0) }}"
     data-mjy-max-rows="{{ question_template_attribute.mjy_table_max_rows|default(20) }}">

    <div class="mjy-repeating-table__editor" hidden>
        <table class="table table-bordered mjy-repeating-table__grid">
            <thead><tr class="mjy-repeating-table__head"></tr></thead>
            <tbody class="mjy-repeating-table__body"></tbody>
        </table>
        <button type="button" class="btn btn-outline-secondary mjy-repeating-table__add">增加一行</button>
    </div>

    <textarea
        class="form-control mjy-repeating-table__raw"
        name="{{ name }}"
        id="answer{{ name }}"
        rows="{{ drows }}"
        aria-labelledby="ls-question-text-{{ basename }}"
    >{{ dispVal }}</textarea>
</div>
<!-- end of answer -->
