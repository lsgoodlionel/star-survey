{#
/**
 * MJY 循环评价：每个评价对象一行，每个维度一列，整张表序列化成 JSON 信封。
 *
 * 真正被提交的永远是下面那个 textarea（name = 引擎字段名），评分表只是它的编辑器。
 * 关掉 JavaScript 时 textarea 直接可见，作答者仍能提交合法的 JSON —— 服务端校验
 * （MjyQuestionExtensions::beforeSurveyPage）对两条路径一视同仁。
 *
 * @var name  引擎字段名（Q<qid>）
 * @var dispVal  已存的 JSON 信封
 * @var question_template_attribute  mjy_table_columns / mjy_loop_objects / min / max
 */
#}
<!-- MJY loop rating -->
<div class="{{ coreClass }} {{ extraclass }} mjy-loop-rating"
     data-mjy-loop-rating="1"
     data-mjy-field="{{ name }}"
     {# 只能用沙箱白名单里的过滤器，别名 e 不在其中（application/config/internal.php:331） #}
     data-mjy-columns="{{ question_template_attribute.mjy_table_columns|escape('html_attr') }}"
     data-mjy-objects="{{ question_template_attribute.mjy_loop_objects|escape('html_attr') }}"
     data-mjy-min-rows="{{ question_template_attribute.mjy_table_min_rows|default(0) }}"
     data-mjy-max-rows="{{ question_template_attribute.mjy_table_max_rows|default(20) }}">

    <div class="mjy-loop-rating__editor" hidden>
        <table class="table table-bordered mjy-loop-rating__grid">
            <thead><tr class="mjy-loop-rating__head"></tr></thead>
            <tbody class="mjy-loop-rating__body"></tbody>
        </table>
    </div>

    <textarea
        class="form-control mjy-loop-rating__raw"
        name="{{ name }}"
        id="answer{{ name }}"
        rows="{{ drows }}"
        aria-labelledby="ls-question-text-{{ basename }}"
    >{{ dispVal }}</textarea>
</div>
<!-- end of answer -->
