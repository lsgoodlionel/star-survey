<?xml version="1.0" encoding="UTF-8"?>
<!--
  MJY 文字点睛（需求 R02-22）。

  在一段原文上标出若干处，每处给一个标记（喜欢／不喜欢／看不懂……）。引擎没有这个
  题型，本主题扩展长文本题（type T），把「标了哪几段、各标成什么」序列化成 JSON 信封
  存进长文本列，结构投影进插件副表（platform/contracts/question-extension-tables-v1.md）。

  两列：segment 是枚举＋唯一（只能是平台声明过的片段，同一段不能标两次），
  tag 是枚举（只能是声明过的标记）。两条约束都在服务端由插件重算。

  **可标的片段由平台声明，不是作答者随手拉选区。** 自由选区意味着作答者可以提交任意
  一对偏移，服务端除了「落在原文长度内」以外没有别的依据；声明过的片段则让「标了原文
  以外的东西」由枚举列自己挡住。片段的取值代码里同时带着偏移与该段原文的指纹
  （s<起点>_<长度>_<指纹>），于是「中文标记偏移和原文版本一致」有了服务端依据：
  改了原文，代码就变，结构摘要跟着变，重新发布时能发现「改了原文却没换结构版本」。

  原文与片段偏移放 mjy_highlight_text 与 mjy_highlight_segments，由发布网关按
  themeOptions 生成，作者不能直写。

  answercolumndefinition 把答卷列从默认的 text 提升为 mediumtext
  （application/models/QuestionTheme.php:775）。这个标签**不能**用 CDATA 包起来。
-->
<config>
    <metadata>
        <name>mjy-text-highlight</name>
        <type>question_theme</type>
        <title>MJY 文字点睛</title>
        <creationDate>2026-09-24</creationDate>
        <author>MJY Platform</author>
        <authorEmail>wp02@example.invalid</authorEmail>
        <authorUrl>https://example.invalid</authorUrl>
        <copyright>Copyright (C) 2026 MJY Platform</copyright>
        <license>GNU General Public License version 2 or later</license>
        <version>1.0</version>
        <apiVersion>1</apiVersion>
        <description>文字点睛：在原文上按声明好的片段标记，结构投影进副表</description>
        <questionType>T</questionType>
        <group>Text questions</group>
        <subquestions>0</subquestions>
        <answerscales>0</answerscales>
        <hasdefaultvalues>0</hasdefaultvalues>
        <assessable>0</assessable>
        <class>text-long mjy-text-highlight</class>
        <answercolumndefinition>mediumtext</answercolumndefinition>
    </metadata>

    <compatibility>
        <version>7.0</version>
    </compatibility>

    <files>
        <css>
            <filename>scripts/mjy-text-highlight.css</filename>
        </css>
        <js>
            <filename>scripts/mjy-text-highlight.js</filename>
        </js>
    </files>

    <attributes>
        <attribute>
            <name>mjy_table_columns</name>
            <category>MJY 文字点睛</category>
            <sortorder>10</sortorder>
            <inputtype>textarea</inputtype>
            <default></default>
            <caption>列定义（JSON）</caption>
            <help>两列：segment（枚举＋唯一）与 tag（枚举）</help>
        </attribute>
        <attribute>
            <name>mjy_highlight_text</name>
            <category>MJY 文字点睛</category>
            <sortorder>20</sortorder>
            <inputtype>textarea</inputtype>
            <default></default>
            <caption>原文</caption>
            <help>片段偏移按这段原文的字符计；改了原文就必须换结构版本</help>
        </attribute>
        <attribute>
            <name>mjy_highlight_segments</name>
            <category>MJY 文字点睛</category>
            <sortorder>30</sortorder>
            <inputtype>textarea</inputtype>
            <default></default>
            <caption>可标记的片段（JSON）</caption>
            <help>形如 [{"code":"s0_4_9f8c2a","start":0,"length":4}]，按偏移升序且互不重叠</help>
        </attribute>
        <attribute>
            <name>mjy_table_min_rows</name>
            <category>MJY 文字点睛</category>
            <sortorder>40</sortorder>
            <inputtype>integer</inputtype>
            <default>0</default>
            <caption>最少标几处</caption>
            <help>0 表示允许不标</help>
        </attribute>
        <attribute>
            <name>mjy_table_max_rows</name>
            <category>MJY 文字点睛</category>
            <sortorder>50</sortorder>
            <inputtype>integer</inputtype>
            <default>10</default>
            <caption>最多标几处</caption>
            <help>服务端强制，浏览器端只是提示</help>
        </attribute>
    </attributes>

    <engine>
        <load_core_css>true</load_core_css>
        <load_core_js>true</load_core_js>
        <show_as_template>true</show_as_template>
        <show_as_question_type>true</show_as_question_type>
    </engine>
</config>
