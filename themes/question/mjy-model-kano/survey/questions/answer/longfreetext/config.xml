<?xml version="1.0" encoding="UTF-8"?>
<!--
  MJY 专业模型：KANO（需求 R02-47 的第一个模型）。

  KANO 每个功能点问两遍——「具备时你怎么想」「不具备时你怎么想」，两问共用同一套
  **由模型固定的**五点量表（喜欢这样／理所当然／无所谓／勉强接受／不喜欢这样）。
  引擎没有这个题型，本主题扩展长文本题（type T），把整份问卷序列化成 JSON 信封
  存进长文本列，结构投影进插件副表（platform/contracts/question-extension-tables-v1.md）。

  三列：feature 是枚举＋唯一（只能是声明过的功能点，同一个不能问两次），
  functional 与 dysfunctional 都是枚举到那套固定量表。行数钉死成功能点个数。

  **量表不是作者能配的。** 这是「按模型设计生成采集结构」与「作者自己搭一个矩阵」
  的区别：换了量表，KANO 的 5×5 分类表就不再适用，算出来的也不是 KANO 分类。
  发布网关会把 themeOptions.scale 之类的键当成未知选项拒掉（E_THEME_OPTION_UNKNOWN）。

  mjy_model_name 记下模型名，读端按它取对应的分析口径，不靠猜列名——「连接可复现
  分析」的锚点就是「模型名 ＋ 结构版本 ＋ 列字典」这三样。分类与 Better/Worse
  系数的计算本身属于统计口径（WP-08），不在本主题里。

  answercolumndefinition 把答卷列从默认的 text 提升为 mediumtext
  （application/models/QuestionTheme.php:775）。这个标签**不能**用 CDATA 包起来。
-->
<config>
    <metadata>
        <name>mjy-model-kano</name>
        <type>question_theme</type>
        <title>MJY 专业模型：KANO</title>
        <creationDate>2026-09-24</creationDate>
        <author>MJY Platform</author>
        <authorEmail>wp02@example.invalid</authorEmail>
        <authorUrl>https://example.invalid</authorUrl>
        <copyright>Copyright (C) 2026 MJY Platform</copyright>
        <license>GNU General Public License version 2 or later</license>
        <version>1.0</version>
        <apiVersion>1</apiVersion>
        <description>KANO 模型：每个功能点正反各问一遍，量表由模型固定，结构投影进副表</description>
        <questionType>T</questionType>
        <group>Text questions</group>
        <subquestions>0</subquestions>
        <answerscales>0</answerscales>
        <hasdefaultvalues>0</hasdefaultvalues>
        <assessable>0</assessable>
        <class>text-long mjy-model-kano</class>
        <answercolumndefinition>mediumtext</answercolumndefinition>
    </metadata>

    <compatibility>
        <version>7.0</version>
    </compatibility>

    <files>
        <css>
            <filename>scripts/mjy-model-kano.css</filename>
        </css>
        <js>
            <filename>scripts/mjy-model-kano.js</filename>
        </js>
    </files>

    <attributes>
        <attribute>
            <name>mjy_table_columns</name>
            <category>MJY 专业模型</category>
            <sortorder>10</sortorder>
            <inputtype>textarea</inputtype>
            <default></default>
            <caption>列定义（JSON）</caption>
            <help>三列：feature（枚举＋唯一）、functional 与 dysfunctional（枚举到固定量表）</help>
        </attribute>
        <attribute>
            <name>mjy_model_name</name>
            <category>MJY 专业模型</category>
            <sortorder>20</sortorder>
            <inputtype>text</inputtype>
            <default></default>
            <caption>模型名</caption>
            <help>读端按它取对应的分析口径；本主题恒为 kano</help>
        </attribute>
        <attribute>
            <name>mjy_model_features</name>
            <category>MJY 专业模型</category>
            <sortorder>30</sortorder>
            <inputtype>textarea</inputtype>
            <default></default>
            <caption>功能点（JSON）</caption>
            <help>形如 [{"code":"F1","label":"夜间模式"}]，一个功能点一行</help>
        </attribute>
        <attribute>
            <name>mjy_table_min_rows</name>
            <category>MJY 专业模型</category>
            <sortorder>40</sortorder>
            <inputtype>integer</inputtype>
            <default>0</default>
            <caption>最少几个功能点</caption>
            <help>由平台钉死成功能点个数，作者改不了</help>
        </attribute>
        <attribute>
            <name>mjy_table_max_rows</name>
            <category>MJY 专业模型</category>
            <sortorder>50</sortorder>
            <inputtype>integer</inputtype>
            <default>0</default>
            <caption>最多几个功能点</caption>
            <help>同上；服务端强制，浏览器端只是提示</help>
        </attribute>
    </attributes>

    <engine>
        <load_core_css>true</load_core_css>
        <load_core_js>true</load_core_js>
        <show_as_template>true</show_as_template>
        <show_as_question_type>true</show_as_question_type>
    </engine>
</config>
