# Copy this file to a private environment file. Replace image tags with release digests.
PUBLIC_HOST=survey.example.com
CADDY_IMAGE=caddy:2.11.6-alpine
ADMIN_IMAGE=ghcr.io/lsgoodlionel/survey-admin-web:0.1.0
PLATFORM_IMAGE=ghcr.io/lsgoodlionel/survey-platform:0.1.0
PUBLISH_GATEWAY_IMAGE=ghcr.io/lsgoodlionel/survey-publish-gateway:0.1.0
ENGINE_IMAGE=ghcr.io/lsgoodlionel/survey-engine:0.1.0
POSTGRES_IMAGE=postgres:16.10-alpine
MARIADB_IMAGE=mariadb:10.11.14

ENGINE_INSTANCE_ID=production-engine-01
ENGINE_ADMIN_USER=replace-with-operations-user
ENGINE_ADMIN_EMAIL=replace-with-operations-email
ENGINES_CONFIG_FILE=./engines.json

# Paths only. Secret contents must not be placed in this file.
ENGINE_ADMIN_PASSWORD_HASH_FILE=./secrets/engine_admin_password_hash
ENGINE_ADMIN_PASSWORD_FILE=./secrets/engine_admin_password
ENGINE_DB_PASSWORD_FILE=./secrets/engine_db_password
ENGINE_DB_ROOT_PASSWORD_FILE=./secrets/engine_db_root_password
PLATFORM_DB_SUPERUSER_PASSWORD_FILE=./secrets/platform_db_superuser_password
PLATFORM_DB_OWNER_PASSWORD_FILE=./secrets/platform_db_owner_password
PLATFORM_DB_APP_PASSWORD_FILE=./secrets/platform_db_app_password
PLATFORM_JWT_HMAC_SECRET_FILE=./secrets/platform_jwt_hmac_secret
PLATFORM_ENGINE_EVENTS_SECRET_FILE=./secrets/platform_engine_events_secret
ENGINE_INSTANCE_EVENTS_SECRET_FILE=./secrets/engine_instance_events_secret
PUBGW_ENGINE_CHANNEL_SECRET_FILE=./secrets/pubgw_engine_channel_secret
PLATFORM_PUBGW_SECRET_FILE=./secrets/platform_pubgw_secret
PUBGW_ENGINE_ADMIN_PASSWORD_FILE=./secrets/pubgw_engine_admin_password

# Optional SMTP delivery overlay (compose.email.yml). Keep delivery disabled in base compose.
# Provider choices are gmail, outlook-com (Hotmail/Outlook.com, OAuth2 token), and netease-163.
PLATFORM_DELIVERY_EMAIL_PROVIDER=gmail
PLATFORM_DELIVERY_EMAIL_AUTH_MODE=app-password
PLATFORM_DELIVERY_EMAIL_FROM_ADDRESS=replace-with-authorized-sender@example.com
PLATFORM_DELIVERY_EMAIL_USERNAME=replace-with-authorized-sender@example.com
# Path only; the app password / OAuth2 access token is never placed in this file.
PLATFORM_DELIVERY_EMAIL_CREDENTIAL_FILE=./secrets/platform_delivery_email_credential
