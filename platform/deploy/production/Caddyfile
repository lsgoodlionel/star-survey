{
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

(proxy_headers) {
	header_up -X-Forwarded-For
	header_up -X-Forwarded-Prefix
	header_up X-Forwarded-For {client_ip}
}

{$PUBLIC_HOST} {
	encode zstd gzip
	request_body {
		max_size 32MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	redir /engine-admin /engine-admin/ 308
	handle_path /engine-admin/* {
		basic_auth {
			{$ENGINE_ADMIN_USER} {$ENGINE_ADMIN_PASSWORD_HASH}
		}
		@health_path path /production-health.php
		respond @health_path 404
		@admin_root path /
		rewrite @admin_root /index.php/admin
		reverse_proxy engine:80 {
			import proxy_headers
			header_up X-Forwarded-Prefix /engine-admin
		}
	}

	redir /survey /survey/ 308
	handle_path /survey/* {
		@admin_path path /admin* /index.php/admin* /production-health.php
		respond @admin_path 404
		reverse_proxy engine:80 {
			import proxy_headers
			header_up X-Forwarded-Prefix /survey
		}
	}

	@platform_api path /v1 /v1/*
	handle @platform_api {
		reverse_proxy platform:8080 {
			import proxy_headers
		}
	}
	handle /d/* {
		reverse_proxy platform:8080 {
			import proxy_headers
		}
	}
	handle /a/* {
		reverse_proxy platform:8080 {
			import proxy_headers
		}
	}
	handle {
		reverse_proxy admin-web:80 {
			import proxy_headers
		}
	}
}

http://127.0.0.1 {
	@local remote_ip 127.0.0.1 ::1
	handle @local {
		rewrite * /production-health.php
		reverse_proxy engine:80
	}
	respond 404
}
