# syntax=docker/dockerfile:1.7
FROM alpine:3.24
ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=unknown
ARG APK_MIRROR=""
LABEL org.opencontainers.image.title="Survey Engine" \
      org.opencontainers.image.source="https://github.com/lsgoodlionel/star-survey" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.created="$CREATED"
RUN set -eux; \
    cp /etc/apk/repositories /tmp/repositories.official; \
    if [ -n "$APK_MIRROR" ]; then sed -i "s#https://dl-cdn.alpinelinux.org/alpine#${APK_MIRROR%/}#g" /etc/apk/repositories; fi; \
    apk update || { cp /tmp/repositories.official /etc/apk/repositories; apk update; }; \
    apk upgrade --no-cache; \
    apk add --no-cache apache2 php83 php83-apache2 php83-calendar php83-ctype php83-curl php83-dom php83-fileinfo php83-gd php83-iconv php83-intl php83-ldap php83-mbstring php83-mysqli php83-opcache php83-openssl php83-pdo php83-pdo_mysql php83-pdo_pgsql php83-pdo_sqlite php83-pgsql php83-phar php83-posix php83-session php83-simplexml php83-sodium php83-sqlite3 php83-tokenizer php83-xml php83-xmlreader php83-xmlwriter php83-zip php83-zlib; \
    cp /tmp/repositories.official /etc/apk/repositories; rm /tmp/repositories.official; \
    ln -sf /usr/bin/php83 /usr/local/bin/php; \
    addgroup -g 10001 survey; adduser -D -H -u 10001 -G survey survey; \
    sed -i -e 's/^User .*/User survey/' -e 's/^Group .*/Group survey/' -e 's#^DocumentRoot .*#DocumentRoot "/var/www/html"#' -e 's/^#LoadModule rewrite_module/LoadModule rewrite_module/' /etc/apache2/httpd.conf; \
    mkdir -p /run/apache2 /var/log/apache2 /var/www/html; \
    chown -R 10001:10001 /run/apache2 /var/log/apache2
COPY <<'CONF' /etc/apache2/conf.d/survey.conf
ServerName localhost
PidFile /run/apache2/httpd.pid
DirectoryIndex index.php index.html
<Directory "/var/www/html">
    Options -Indexes +FollowSymLinks
    AllowOverride All
    Require all granted
</Directory>
CONF
COPY <<'SCRIPT' /usr/local/bin/apache2-foreground
#!/bin/sh
set -eu
rm -f /run/apache2/httpd.pid
exec httpd -D FOREGROUND
SCRIPT
RUN chmod 755 /usr/local/bin/apache2-foreground
WORKDIR /var/www/html
COPY --chown=10001:10001 . /var/www/html
COPY platform/deploy/dev/engine-static-guard.conf /etc/apache2/conf.d/zz-engine-static-guard.conf
RUN mkdir -p application/runtime tmp/runtime upload && chown -R 10001:10001 application/runtime tmp upload
EXPOSE 80
USER 10001:10001
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD php -r '$s=@fsockopen("127.0.0.1",80,$e,$m,2); exit($s?0:1);'
CMD ["apache2-foreground"]
