# syntax=docker/dockerfile:1.7
FROM php:8.3-apache-bookworm

ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=unknown
ARG APT_MIRROR=""

LABEL org.opencontainers.image.title="Survey Engine" \
      org.opencontainers.image.source="https://github.com/lsgoodlionel/star-survey" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.created="$CREATED"

RUN set -eux; \
    if [ -n "$APT_MIRROR" ]; then \
      cp /etc/apt/sources.list.d/debian.sources /tmp/debian.sources.official; \
      sed -ri "s#https?://deb.debian.org/debian-security#${APT_MIRROR%/}-security#g; s#https?://deb.debian.org/debian#${APT_MIRROR%/}#g" /etc/apt/sources.list.d/debian.sources; \
      apt-get update || { cp /tmp/debian.sources.official /etc/apt/sources.list.d/debian.sources; apt-get update; }; \
    else apt-get update; fi; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends \
      libcap2-bin libfreetype6-dev libicu-dev libjpeg62-turbo-dev libldap2-dev libonig-dev \
      libpng-dev libpq-dev libsodium-dev libxml2-dev libzip-dev; \
    docker-php-ext-configure gd --with-freetype --with-jpeg; \
    docker-php-ext-install -j"$(nproc)" calendar gd intl ldap mbstring mysqli pdo_mysql pdo_pgsql pgsql sodium xml zip; \
    a2enmod rewrite; \
    setcap cap_net_bind_service=+ep /usr/sbin/apache2; \
    if [ -f /tmp/debian.sources.official ]; then \
      cp /tmp/debian.sources.official /etc/apt/sources.list.d/debian.sources; \
      rm -f /tmp/debian.sources.official; \
    fi; \
    rm -rf /var/lib/apt/lists/*

COPY --chown=10001:10001 . /var/www/html
COPY --chown=10001:10001 platform/deploy/dev/engine-static-guard.conf /etc/apache2/conf-enabled/zz-engine-static-guard.conf

RUN set -eux; \
    groupadd --gid 10001 survey; \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin survey; \
    mkdir -p /var/run/apache2 /var/lock/apache2 /var/log/apache2 /var/www/html/application/runtime /var/www/html/tmp/runtime /var/www/html/upload; \
    chown -R 10001:10001 /var/run/apache2 /var/lock/apache2 /var/log/apache2 /var/www/html/application/runtime /var/www/html/tmp /var/www/html/upload

ENV APACHE_RUN_USER=survey \
    APACHE_RUN_GROUP=survey \
    APACHE_PID_FILE=/var/run/apache2/apache2.pid \
    APACHE_RUN_DIR=/var/run/apache2 \
    APACHE_LOCK_DIR=/var/lock/apache2 \
    APACHE_LOG_DIR=/var/log/apache2

EXPOSE 80
USER 10001:10001
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD php -r '$s=@fsockopen("127.0.0.1",80,$e,$m,2); exit($s?0:1);'
CMD ["apache2-foreground"]
