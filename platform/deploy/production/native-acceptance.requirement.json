{
  "schemaVersion": 2,
  "requirementId": "production-native-clean-host-v1",
  "releaseBlocking": true,
  "releaseBlockingExecution": {
    "entrypoint": "platform/deploy/production/release/native_acceptance.sh",
    "environment": {
      "NATIVE_ACCEPTANCE_REAL": "1",
      "SURVEY_NATIVE_ACCEPTANCE": "1"
    }
  },
  "legacyOptInTest": {
    "path": "platform/deploy/production/tests/test_install_upgrade.py",
    "enableEnvironment": "SURVEY_PRODUCTION_E2E=1",
    "releaseBlocking": false
  },
  "matrix": {
    "ubuntu": ["22.04", "24.04"],
    "architecture": ["amd64", "arm64"]
  },
  "requiredJourney": [
    "install",
    "doctor-before",
    "minimal-product-journey",
    "backup",
    "upgrade",
    "doctor-after",
    "restore-refused",
    "doctor-final",
    "uninstall"
  ],
  "deferredUntilStable": {
    "decision": "https://github.com/lsgoodlionel/star-survey/issues/119",
    "journey": ["restore", "doctor-restored"],
    "reason": "Option B: prerelease lifecycle acceptance is separate from controlled recovery; stable still requires the #33 recovery plan"
  },
  "owner": "multiarch-release-plan-task3"
}
