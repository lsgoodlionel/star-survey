{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://star-survey.local/schemas/capabilities.schema.json",
  "title": "Survey productization capability baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilities"],
  "properties": {
    "$schema": {
      "const": "./capabilities.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "deliveryState": {
      "enum": ["complete", "partial", "not_started", "external"]
    },
    "requirementVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "acceptanceLocator"],
      "properties": {
        "requirementId": {"type": "string", "pattern": "^R[0-9]{2}-[0-9]{2}$"},
        "acceptanceLocator": {"type": "string", "minLength": 1}
      }
    },
    "testVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result", "observedAt", "commit"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "result": {"const": "passed"},
        "observedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      }
    },
    "browserVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result", "observedAt", "commit", "browserArtifactLocator"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "result": {"const": "passed"},
        "observedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "browserArtifactLocator": {"type": "string", "minLength": 1}
      }
    },
    "productionVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "os", "arch", "command", "result", "observedAt", "commit"],
      "properties": {
        "environment": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "result": {"const": "passed"},
        "observedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      }
    },
    "traceabilityVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result", "observedAt", "commit", "artifactLocator"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "result": {"const": "passed"},
        "observedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "artifactLocator": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "kind", "path", "locator", "description"],
      "properties": {
        "layer": {
          "enum": ["requirement", "backend", "frontend", "flow", "production", "traceability"]
        },
        "kind": {
          "enum": ["requirement-spec", "implementation", "automated-test", "audit", "browser-test", "deployment-baseline", "production-run", "traceability-record", "traceability-check", "release-attestation"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "object"
        }
      },
      "allOf": [
        {"if": {"properties": {"layer": {"const": "requirement"}}, "required": ["layer"]}, "then": {"properties": {"kind": {"const": "requirement-spec"}}}},
        {"if": {"properties": {"layer": {"const": "backend"}}, "required": ["layer"]}, "then": {"properties": {"kind": {"enum": ["implementation", "automated-test"]}}}},
        {"if": {"properties": {"layer": {"const": "frontend"}}, "required": ["layer"]}, "then": {"properties": {"kind": {"enum": ["implementation", "automated-test", "audit"]}}}},
        {"if": {"properties": {"layer": {"const": "flow"}}, "required": ["layer"]}, "then": {"properties": {"kind": {"enum": ["audit", "browser-test"]}}}},
        {"if": {"properties": {"layer": {"const": "production"}}, "required": ["layer"]}, "then": {"properties": {"kind": {"enum": ["deployment-baseline", "production-run", "audit"]}}}},
        {"if": {"properties": {"layer": {"const": "traceability"}}, "required": ["layer"]}, "then": {"properties": {"kind": {"enum": ["traceability-record", "traceability-check", "release-attestation"]}}}}
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "requirementIds",
        "backend",
        "frontend",
        "flow",
        "production",
        "status",
        "evidence",
        "nextWave"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^R[0-9]{2}-[0-9]{2}$"
          }
        },
        "backend": {
          "$ref": "#/$defs/deliveryState"
        },
        "frontend": {
          "$ref": "#/$defs/deliveryState"
        },
        "flow": {
          "$ref": "#/$defs/deliveryState"
        },
        "production": {
          "$ref": "#/$defs/deliveryState"
        },
        "status": {
          "enum": ["accepted", "partial", "not_started", "external"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "nextWave": {
          "enum": ["Wave 0", "Wave 1", "Wave 2", "Wave 3", "Wave 4", "Wave 5", "Wave 6"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            },
            "required": ["status"]
          },
          "then": {
            "x-requireDistinctEvidenceIdentities": true,
            "properties": {
              "backend": {"const": "complete"},
              "frontend": {"const": "complete"},
              "flow": {"const": "complete"},
              "production": {"const": "complete"},
              "evidence": {
                "allOf": [
                  {"contains": {"required": ["layer", "kind", "verification"], "properties": {"layer": {"const": "requirement"}, "kind": {"const": "requirement-spec"}, "verification": {"$ref": "#/$defs/requirementVerification"}}}},
                  {"contains": {"required": ["layer", "kind", "verification"], "properties": {"layer": {"const": "backend"}, "kind": {"const": "automated-test"}, "verification": {"$ref": "#/$defs/testVerification"}}}},
                  {"contains": {"required": ["layer", "kind", "verification"], "properties": {"layer": {"const": "frontend"}, "kind": {"const": "automated-test"}, "verification": {"$ref": "#/$defs/testVerification"}}}},
                  {"contains": {"required": ["layer", "kind", "verification"], "properties": {"layer": {"const": "flow"}, "kind": {"const": "browser-test"}, "verification": {"$ref": "#/$defs/browserVerification"}}}},
                  {"contains": {"required": ["layer", "kind", "verification"], "properties": {"layer": {"const": "production"}, "kind": {"const": "production-run"}, "verification": {"$ref": "#/$defs/productionVerification"}}}},
                  {"contains": {"required": ["layer", "kind", "verification"], "properties": {"layer": {"const": "traceability"}, "kind": {"enum": ["traceability-check", "release-attestation"]}, "verification": {"$ref": "#/$defs/traceabilityVerification"}}}}
                ]
              }
            }
          }
        }
      ]
    }
  }
}
