#!/bin/sh
set -eu

case "$0" in
    /*) wrapper_path=$0 ;;
    *) wrapper_path=$(pwd -P)/$0 ;;
esac
wrapper_dir=${wrapper_path%/*}
wrapper_dir=$(CDPATH= cd -P -- "$wrapper_dir" && printf '%s\n' "$PWD") || exit 2
wrapper_path=$wrapper_dir/${wrapper_path##*/}

bootstrap=/usr/bin/python3
if [ ! -x "$bootstrap" ] || [ -L "$bootstrap" ]; then
    printf '%s\n' '{"error":"没有可信的 Python bootstrap","exitCode":2}'
    exit 2
fi
PATH=/usr/bin:/bin
TMPDIR=/tmp
export PATH TMPDIR

exec "$bootstrap" - "$wrapper_path" "$@" <<'PY'
import glob
import os
from pathlib import Path
import pwd
import stat
import sys


def fail(message):
    print('{"error":"' + message + '","exitCode":2}')
    raise SystemExit(2)


def trusted_runtime(candidate, root, owner):
    try:
        candidate = Path(candidate)
        root = Path(root).resolve(strict=True)
        if (not candidate.is_absolute() or candidate.is_symlink()
                or candidate.name not in {f"python3.{minor}" for minor in range(11, 15)}):
            return None
        target = candidate.resolve(strict=True)
        if target != candidate or not target.is_relative_to(root):
            return None
        metadata = target.stat()
        if (not stat.S_ISREG(metadata.st_mode) or not os.access(target, os.X_OK)
                or metadata.st_uid not in (0, owner)
                or metadata.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            return None
        current = target.parent
        while True:
            metadata = current.stat()
            if (metadata.st_uid not in (0, owner)
                    or metadata.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
                return None
            if current == root:
                return target
            if current == current.parent or not current.is_relative_to(root):
                return None
            current = current.parent
    except (OSError, RuntimeError, ValueError):
        return None


try:
    wrapper = Path(sys.argv[1]).resolve(strict=True)
    repo = wrapper.parent.parent
    expected = repo / "scripts/agent-harness"
    version_probe = sys.argv[2:] == ["--python", "--version"]
    if (wrapper != expected or wrapper.is_symlink()
            or not version_probe and not (repo / "tools/agent-harness/agent_harness").is_dir()):
        fail("Harness 入口位置不可信")
    account = pwd.getpwuid(os.getuid())
    home = Path(account.pw_dir).resolve(strict=True)
except (KeyError, OSError, RuntimeError, ValueError):
    fail("无法建立 Harness 信任根")

candidates = []
for prefix in ("/usr", "/usr/local", "/opt/homebrew"):
    candidates.extend((f"{prefix}/bin/python3.{minor}", prefix, 0) for minor in range(14, 10, -1))
uv_root = home / ".local/share/uv/python"
if uv_root.is_dir():
    for minor in range(14, 10, -1):
        for value in sorted(glob.glob(str(uv_root / f"cpython-3.{minor}.*-*/bin/python3.{minor}")), reverse=True):
            candidates.append((value, str(uv_root), os.getuid()))

runtime = next((value for candidate, root, owner in candidates
                if (value := trusted_runtime(candidate, root, owner)) is not None), None)
if runtime is None:
    fail("需要可信的 Python 3.11-3.14 runtime")

arguments = sys.argv[2:]
environment = {
    "HOME": str(home),
    "PATH": "/usr/bin:/bin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONPATH": str(repo / "tools/agent-harness"),
}
if arguments[:1] == ["--python"]:
    command = arguments[1:]
    allowed = (command == ["--version"]
               or command[:2] == ["-m", "unittest"] and len(command) > 2
               or command == ["-m", "reqtrace.cli", "check"]
               or command == ["platform/tools/productization/render_capabilities.py", "--check"])
    if not allowed:
        fail("不允许的 Python Gate 入口")
    if command == ["--version"]:
        os.execve(runtime, [str(runtime), "--version"], environment)
    target = command
else:
    target = ["-m", "agent_harness.cli", "--repo", str(repo), *arguments]

launcher = r'''
import os
from pathlib import Path
import sys

from agent_harness.codex_adapter import _environment

repo = Path(sys.argv[1])
try:
    environment = _environment(repo)
except (OSError, RuntimeError, TypeError, ValueError):
    print('{"error":"受控工具不可用或不受信任","exitCode":2}')
    raise SystemExit(2)
environment["PYTHONDONTWRITEBYTECODE"] = "1"
environment["PYTHONPATH"] = str(repo / "tools/agent-harness")
os.execve(sys.executable, [sys.executable, *sys.argv[2:]], environment)
'''
os.execve(runtime, [str(runtime), "-c", launcher, str(repo), *target], environment)
PY
