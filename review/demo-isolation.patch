+# Fail closed before the first write; the target project is disposable and must be new.
+require_empty_review_target() {
+  local name output host
+  for name in DOCKER_HOST DOCKER_CONTEXT COMPOSE_PROJECT_NAME COMPOSE_FILE COMPOSE_PROFILES COMPOSE_ENV_FILES ADMIN_WEB_DEMO_PORT PLATFORM_MAVEN_REPO; do
+    [[ -z "${!name:-}" ]] || fail "unexpected environment override: $name"
+  done
+  [[ ! -e "$RUNTIME_DIR" && ! -L "$RUNTIME_DIR" ]] || fail "review runtime already exists"
+  for name in "$DEMO_DIR/.env" "$REPO_ROOT/.env" "$PWD/.env"; do
+    [[ ! -e "$name" && ! -L "$name" ]] || fail "unexpected Compose env file"
+  done
+  host="$("${DOCKER[@]}" context inspect --format '{{.Endpoints.docker.Host}}')"
+  [[ "$host" == "unix:///Users/lionel/.docker/run/docker.sock" ]] || fail "unexpected Docker endpoint"
+  "${DOCKER[@]}" info --format '{{.ID}}' >/dev/null || fail "Docker daemon unavailable"
+  output="$("${DOCKER[@]}" ps -aq --filter "label=com.docker.compose.project=$PROJECT")" || fail "container list unavailable"
+  [[ -z "$output" ]] || fail "review project already has containers"
+  output="$("${DOCKER[@]}" ps -aq --filter "name=^/${PROJECT}[-_]")" || fail "container names unavailable"
+  [[ -z "$output" ]] || fail "review container name already exists"
+  output="$("${DOCKER[@]}" volume ls -q)" || fail "volume list unavailable"
+  for name in "${PROJECT}_engine-data" "${PROJECT}_engine-runtime" "${PROJECT}_engine-tmp" "${PROJECT}_platform-data" survey-review-46766fd-maven; do
+    if printf '%s\n' "$output" | grep -Fqx -- "$name"; then fail "review volume already exists"; fi
+  done
+  output="$("${DOCKER[@]}" network ls --format '{{.Name}}')" || fail "network list unavailable"
+  if printf '%s\n' "$output" | grep -Fqx -- "${PROJECT}_default"; then fail "review network already exists"; fi
+  output="$("${DOCKER[@]}" image ls --format '{{.Repository}}')" || fail "image list unavailable"
+  for name in survey-review-46766fd-engine survey-review-46766fd-gateway survey-review-46766fd-admin; do
+    if printf '%s\n' "$output" | grep -Fqx -- "$name"; then fail "review image already exists"; fi
+  done
+  python3 - <<'PORTCHECK' || fail "review port unavailable"
+import socket
+s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+try:
+    s.bind(('127.0.0.1', 51891))
+finally:
+    s.close()
+PORTCHECK
 }
 
